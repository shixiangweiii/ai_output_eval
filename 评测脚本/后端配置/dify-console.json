{
  "name": "dify-console",
  "description": "Dify Console 命中测试接口，Cookie + CSRF 鉴权。",
  "url_template": "http://localhost:5001/console/api/datasets/{dataset_id}/hit-testing",
  "method": "POST",
  "auth": "cookie_csrf",
  "auth_env": { "cookie": "RETRIEVAL_COOKIE", "token": "RETRIEVAL_XSRF_TOKEN" },
  "cookie_header": "cookie",
  "token_header": "x-csrf-token",
  "extra_headers": {
    "origin": "http://localhost:3000",
    "referer": "http://localhost:3000/"
  },
  "supports_request_k": true,
  "request_template": {
    "query": "{query}",
    "attachment_ids": [],
    "retrieval_model": {
      "search_method": "hybrid_search",
      "reranking_enable": true,
      "reranking_mode": "reranking_model",
      "reranking_model": {
        "reranking_provider_name": "langgenius/tongyi/tongyi",
        "reranking_model_name": "qwen3-rerank"
      },
      "weights": {
        "weight_type": "customized",
        "keyword_setting": { "keyword_weight": 0.3 },
        "vector_setting": {
          "vector_weight": 0.7,
          "embedding_model_name": "",
          "embedding_provider_name": ""
        }
      },
      "top_k": "{top_k}",
      "score_threshold_enabled": false,
      "score_threshold": null,
      "graph_search": null
    }
  },
  "records_path": "records",
  "field_map": {
    "document_name": "segment.document.name",
    "content": "segment.content",
    "relevance_score": "score",
    "chunk_id": "segment.id",
    "document_id": "segment.document_id",
    "server_top": "segment.position"
  }
}
